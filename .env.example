PORT=3000
APP_URL=http://localhost:3000

# Database & Security
DATABASE_URL=postgresql://user:password@localhost:5432/taswiqat_cloud
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_hex_encryption_key

# Google OAuth (Unified: GBP, GA4, Ads, YouTube, Search Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token

# Meta (Instagram Business, Facebook Page, WhatsApp Business)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:3000/api/oauth/meta/callback

# TikTok Business
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:3000/api/oauth/tiktok/callback

# Snapchat Ads
SNAPCHAT_CLIENT_ID=your_snapchat_client_id
SNAPCHAT_CLIENT_SECRET=your_snapchat_client_secret
SNAPCHAT_REDIRECT_URI=http://localhost:3000/api/oauth/snapchat/callback

# X (Twitter)
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
X_REDIRECT_URI=http://localhost:3000/api/oauth/x/callback
